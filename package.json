{
  "name": "dsh-groupchat",
  "description": "DeepSeek Harness 多智能体群聊插件：独立会话、多模型角色、跨群 @ 协作、任务分工、成员记忆与审批",
  "version": "1.1.0-beta.7",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "TESTING.md",
    "TEST-RESULTS.md",
    "AGENT-COLLABORATION.md"
  ],
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/client.test.mjs tests/host.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fqxxzyw/dsh-groupchat.git"
  },
  "homepage": "https://github.com/fqxxzyw/dsh-groupchat#readme",
  "bugs": {
    "url": "https://github.com/fqxxzyw/dsh-groupchat/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "groupchat",
    "ai",
    "agent",
    "plugins",
    "javascript",
    "open-source"
  ]
}
